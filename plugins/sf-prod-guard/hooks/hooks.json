{
  "description": "Blocks Salesforce CLI commands that can change a production org. Exit 2 blocks. onFailure block: a crash or a timeout also blocks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PLUGIN_ROOT}/guard/block-sf-prod-deploy.sh\"",
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "Checking Salesforce target org"
          }
        ]
      }
    ]
  }
}
