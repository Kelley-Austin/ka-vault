#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────────
# cheese-backup-then-modify
#
# Pulls current Salesforce org metadata for <path>, creates a timestamped
# backup branch, commits, and pushes — before you modify the metadata. Makes
# risky changes reversible without the user needing to know git commands.
#
# Usage:
#   cheese-backup-then-modify <path> [--from-org <alias>]
#
# <path>           File or directory inside force-app/ (passed to
#                  `sf project retrieve start --source-dir`).
# --from-org <a>   Salesforce org alias to retrieve from. Defaults to the
#                  project's default-target-org (`sf config get target-org`).
#
# Output: a single JSON line on stdout describing what happened.
# Exits 0 on success (including "no backup needed"), non-zero on real errors.
# ──────────────────────────────────────────────────────────────────────────────

set -uo pipefail

# ── Args ──────────────────────────────────────────────────────────────────────

PATH_ARG=""
FROM_ORG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --from-org)
      FROM_ORG="$2"; shift 2 ;;
    --from-org=*)
      FROM_ORG="${1#*=}"; shift ;;
    -h|--help)
      cat <<EOF
Usage: cheese-backup-then-modify <path> [--from-org <alias>]

  <path>            Path inside force-app/ to back up (file or directory).
  --from-org <a>    Salesforce org alias to retrieve from (defaults to project default).

Pulls current org state into a backup branch before you modify <path>, so any
mistake is reversible. Push is best-effort — the local commit is the backup.
EOF
      exit 0 ;;
    *)
      if [ -z "$PATH_ARG" ]; then PATH_ARG="$1"; shift
      else echo "Error: unexpected argument: $1" >&2; exit 1
      fi ;;
  esac
done

if [ -z "$PATH_ARG" ]; then
  echo "Error: <path> is required. Run with -h for usage." >&2
  exit 1
fi

# ── Resolve sf binary ────────────────────────────────────────────────────────

SF_BIN="$(command -v sf || true)"
if [ -z "$SF_BIN" ]; then
  for cand in /opt/homebrew/bin/sf /usr/local/bin/sf "$HOME/.local/share/sf/bin/sf"; do
    [ -x "$cand" ] && SF_BIN="$cand" && break
  done
fi
if [ -z "$SF_BIN" ]; then
  echo "Error: 'sf' CLI not found on PATH." >&2
  exit 1
fi

# ── Resolve target org ───────────────────────────────────────────────────────

if [ -z "$FROM_ORG" ]; then
  FROM_ORG="$("$SF_BIN" config get target-org --json 2>/dev/null | jq -r '.result[0].value // ""' 2>/dev/null || echo "")"
fi
if [ -z "$FROM_ORG" ]; then
  echo "Error: no org alias resolved (no --from-org and no project default-target-org)." >&2
  exit 1
fi

# ── Sanity: must be inside a git repo ────────────────────────────────────────

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: must run inside a git repository." >&2
  exit 1
fi
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [ "$CURRENT_BRANCH" = "HEAD" ]; then
  echo "Error: detached HEAD — checkout a branch first." >&2
  exit 1
fi

# ── Stash unrelated dirty work, retrieve, branch, commit, push ───────────────

STASHED="false"
if [ -n "$(git status --porcelain)" ]; then
  git stash push -u -m "cheese-backup-stash" >/dev/null 2>&1 && STASHED="true"
fi

cleanup_on_error() {
  if [ "$STASHED" = "true" ]; then git stash pop >/dev/null 2>&1 || true; fi
}

# Pull current org state into the working tree
if ! "$SF_BIN" project retrieve start --target-org "$FROM_ORG" --source-dir "$PATH_ARG" --json >/dev/null 2>&1; then
  echo "Error: 'sf project retrieve start' failed for path=${PATH_ARG} alias=${FROM_ORG}." >&2
  cleanup_on_error
  exit 1
fi

# Did retrieve actually produce changes for this path?
if git diff --quiet -- "$PATH_ARG" 2>/dev/null \
   && git diff --cached --quiet -- "$PATH_ARG" 2>/dev/null \
   && [ -z "$(git ls-files --others --exclude-standard -- "$PATH_ARG" 2>/dev/null)" ]; then
  cleanup_on_error
  jq -n --arg alias "$FROM_ORG" --arg path "$PATH_ARG" '{
    "status": "no_backup_needed",
    "alias": $alias,
    "path": $path,
    "message": "Working tree already matches org state for this path; nothing to back up."
  }'
  exit 0
fi

# Build a sanitized branch name
SAFE_PATH="$(printf '%s' "$PATH_ARG" | sed -E 's|/+|-|g; s|^-+||; s|-+$||; s|[^a-zA-Z0-9._-]|_|g' | cut -c1-80)"
TIMESTAMP="$(date +%Y%m%d-%H%M)"
BRANCH="backup/${SAFE_PATH}-${TIMESTAMP}"

if ! git checkout -b "$BRANCH" >/dev/null 2>&1; then
  echo "Error: failed to create branch ${BRANCH}." >&2
  cleanup_on_error
  exit 1
fi
git add -- "$PATH_ARG" >/dev/null
git -c commit.gpgsign=false commit -m "backup: ${PATH_ARG} from ${FROM_ORG} before modification" >/dev/null

# Best-effort push
PUSHED="false"
PUSH_ERR=""
if git push -u origin "$BRANCH" >/dev/null 2>&1; then
  PUSHED="true"
else
  PUSH_ERR="push failed; the local commit on ${BRANCH} is still a valid backup"
fi

# Return to original working branch and restore stash
git checkout "$CURRENT_BRANCH" >/dev/null 2>&1
if [ "$STASHED" = "true" ]; then git stash pop >/dev/null 2>&1 || true; fi

# Single JSON line output (Claude can parse)
jq -n \
  --arg branch "$BRANCH" \
  --arg alias "$FROM_ORG" \
  --arg path "$PATH_ARG" \
  --argjson pushed "$([ "$PUSHED" = "true" ] && echo true || echo false)" \
  --arg push_err "$PUSH_ERR" \
  '{
    "status": "backed_up",
    "backup_branch": $branch,
    "alias": $alias,
    "path": $path,
    "pushed": $pushed,
    "push_error": (if $push_err == "" then null else $push_err end)
  }'
